# ── Database ──────────────────────────────
# Username for PostgreSQL database. Consumed by Postgres container & Spring Boot backend. Safe for local dev; replace in production.
POSTGRES_USER=myuser

# Password for PostgreSQL database. Consumed by Postgres container, SeaweedFS filer, & Spring Boot backend. Safe for local dev; MUST be replaced with a strong secret in production.
POSTGRES_PASSWORD=mypassword

# Database name for PostgreSQL. Consumed by Postgres container & Spring Boot backend. Safe for local dev.
POSTGRES_DB=myappdb

# Hostname of PostgreSQL database. Set to "postgres" inside Docker Compose; set to "localhost" when running backend without Docker.
DB_HOST=postgres

# Hostname of Redis cache server. Set to "redis" inside Docker Compose; set to "localhost" when running backend without Docker.
REDIS_HOST=redis

# Password for Redis cache. Consumed by Redis container (--requirepass) and backend/frontend cache. Safe for local dev; MUST be replaced in production.
REDIS_PASSWORD=mypassword

# ── JWT ──────────────────────────────────
# Base64URL-encoded secret key for signing JWT Access Tokens (decoded by Spring Boot JwtService).
# Generate using `openssl rand -base64 32`. Must be replaced with a secure secret in production and kept private.
ACCESS_SECRET=base-64-secret-key-1

# Base64URL-encoded secret key for signing JWT Refresh Tokens (decoded by Spring Boot JwtService).
# Must be a distinct secret from ACCESS_SECRET. Generate using `openssl rand -base64 32`. Must be replaced in production.
REFRESH_SECRET=base-64-secret-key-2

# Access Token expiration duration in SECONDS (600 = 10 minutes). Consumed by Spring Boot JwtService.
ACCESS_EXP=600

# Standard Refresh Token expiration duration in SECONDS (86400 = 24 hours / 1 day). Consumed by Spring Boot JwtService.
REFRESH_EXP=86400

# Extended ("Remember Me") Refresh Token expiration duration in SECONDS (259200 = 72 hours / 3 days). Consumed by Spring Boot JwtService.
MAX_REFRESH_EXP=259200

# ── Backend ───────────────────────────────
# Host machine port mapped to Spring Boot container port 8000 by Docker Compose. Safe for local dev (change if port 8000 is in use on host).
SPRING_PORT=8000

# Spring Boot profile environment ("dev" or "prod"). Controls SQL logging and sample data seeding. Set to "prod" in production.
JAVA_ENV=dev

# ── Frontend ──────────────────────────────
# Host machine port mapped to Next.js container port 3000 by Docker Compose. Safe for local dev (change if port 3000 is in use on host).
NEXT_PORT=3000

# Runtime environment for Next.js ("development" or "production").
NODE_ENV=development

# Internal API endpoint URL used by Next.js server-side code (BFF/proxy) to talk to Spring Boot over internal Docker network.
# Uses internal container hostname "backend" and internal container port 8000 (does NOT use host SPRING_PORT).
API_BASE_URL=http://backend:8000/api/v1

# ── s3 Secrets ────────────────────────────
# Secret key for SeaweedFS S3-compatible file storage. Consumed by backend and SeaweedFS services. Safe for local dev; replace in production.
S3_SECRET_KEY=secret-key-3

# Access key ID for SeaweedFS S3-compatible file storage. Consumed by backend and SeaweedFS services. Safe for local dev; replace in production.
S3_ACCESS_KEY=secret-key-4
